local BASE_URL = "https://raw.githubusercontent.com/tbest8403-dotcom/_____8282829ftf/main/"

local function loadModule(fileName)
	return loadstring(game:HttpGet(BASE_URL .. fileName))()
end

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local highlightFolder = PlayerGui:FindFirstChild("DebugHighlights")
if not highlightFolder then
	highlightFolder = Instance.new("Folder")
	highlightFolder.Name = "DebugHighlights"
	highlightFolder.Parent = PlayerGui
end

local Context = {
	Players = Players,
	RunService = RunService,
	Workspace = Workspace,
	UserInputService = UserInputService,

	LocalPlayer = LocalPlayer,
	PlayerGui = PlayerGui,
	HighlightFolder = highlightFolder
}

local PlayerHighlights = loadModule("playerhightlights")
local ComputerHighlight = loadModule("ComputerHighlight")
local InfiniteWallHop = loadModule("Infinitewallhop")
local GhostMode = loadModule("ghost")
local SafeDistance = loadModule("SafeDistance")

local NightUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/asutse0/NightUILibrary/refs/heads/main/Project"))()

local Window = NightUI:CreateWindow({
	Title = "Flee the Facility",
	KeySystem = true,
	Key = "Flee22",
	DiscordLink = "https://discord.gg/Jc5dpWqBtZ"
})

local Visuals = Window:CreateTab("Visuals")
local Movement = Window:CreateTab("Movement")

local playerHighlights = PlayerHighlights.new(Context)
local computerHighlights = ComputerHighlight.new(Context)
local infiniteWallHop = InfiniteWallHop.new(Context)
local ghostMode = GhostMode.new(Context)
local safeDistance = SafeDistance.new(Context)

Visuals:CreateToggle({
	Name = "Highlight Survivors",
	Default = false,
	Callback = function(enabled)
		playerHighlights:SetSurvivorsEnabled(enabled)
	end
})

Visuals:CreateToggle({
	Name = "Highlight Beast",
	Default = false,
	Callback = function(enabled)
		playerHighlights:SetBeastEnabled(enabled)
	end
})

Visuals:CreateToggle({
	Name = "Highlight Computers",
	Default = false,
	Callback = function(enabled)
		computerHighlights:SetEnabled(enabled)
	end
})

Movement:CreateToggle({
	Name = "Infinite Wall Hop",
	Default = false,
	Callback = function(enabled)
		infiniteWallHop:SetEnabled(enabled)
	end
})

Movement:CreateToggle({
	Name = "Ghost Mode",
	Default = false,
	Callback = function(enabled)
		ghostMode:SetEnabled(enabled)
	end
})

Movement:CreateToggle({
	Name = "Safe Distance Auto Computer",
	Default = false,
	Callback = function(enabled)
		safeDistance:SetEnabled(enabled)
	end
})

playerHighlights:Start()

LocalPlayer.CharacterAdded:Connect(function()
	infiniteWallHop:ResetCooldown()
	ghostMode:Disable()
	safeDistance:Disable()
end)

RunService.RenderStepped:Connect(function()
	playerHighlights:Step()
end)
