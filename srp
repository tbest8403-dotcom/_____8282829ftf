local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local NightUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/asutse0/NightUILibrary/refs/heads/main/Project"))()

local Window = NightUI:CreateWindow({
	Title = "Flee the Facility",
	KeySystem = true,
	Key = "Flee22",
	DiscordLink = "https://discord.gg/Jc5dpWqBtZ"
})

local Visuals = Window:CreateTab("Visuals")

local highlightSurvivorsEnabled = false
local highlightBeastEnabled = false
local highlightComputersEnabled = false

local highlightFolder = PlayerGui:FindFirstChild("DebugHighlights")
if not highlightFolder then
	highlightFolder = Instance.new("Folder")
	highlightFolder.Name = "DebugHighlights"
	highlightFolder.Parent = PlayerGui
end

local characterConnections = {}

--// PLAYER HIGHLIGHT LOGIC

local function hasHammer(character)
	if not character then
		return false
	end

	local hammer = character:FindFirstChild("Hammer")
	return hammer ~= nil and hammer:IsA("Model")
end

local function getPlayerHighlightName(player, highlightType)
	return player.Name .. "_" .. highlightType .. "_Highlight"
end

local function removePlayerHighlight(player, highlightType)
	local existing = highlightFolder:FindFirstChild(getPlayerHighlightName(player, highlightType))

	if existing then
		existing:Destroy()
	end
end

local function createOrUpdatePlayerHighlight(player, character, highlightType, outlineColor)
	local highlightName = getPlayerHighlightName(player, highlightType)
	local existing = highlightFolder:FindFirstChild(highlightName)

	if existing then
		existing.Adornee = character
		existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		existing.FillTransparency = 1
		existing.OutlineTransparency = 0
		existing.OutlineColor = outlineColor
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = highlightName
	highlight.Adornee = character
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.OutlineColor = outlineColor
	highlight.Parent = highlightFolder
end

local function updatePlayerHighlights()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local character = player.Character

			if character then
				local beast = hasHammer(character)
				local survivor = not beast

				if highlightSurvivorsEnabled and survivor then
					createOrUpdatePlayerHighlight(
						player,
						character,
						"Survivor",
						Color3.fromRGB(0, 255, 100)
					)
				else
					removePlayerHighlight(player, "Survivor")
				end

				if highlightBeastEnabled and beast then
					createOrUpdatePlayerHighlight(
						player,
						character,
						"Beast",
						Color3.fromRGB(255, 60, 60)
					)
				else
					removePlayerHighlight(player, "Beast")
				end
			else
				removePlayerHighlight(player, "Survivor")
				removePlayerHighlight(player, "Beast")
			end
		end
	end
end

local function clearSurvivorHighlights()
	for _, player in ipairs(Players:GetPlayers()) do
		removePlayerHighlight(player, "Survivor")
	end
end

local function clearBeastHighlights()
	for _, player in ipairs(Players:GetPlayers()) do
		removePlayerHighlight(player, "Beast")
	end
end

local function watchCharacter(player, character)
	if characterConnections[player] then
		for _, connection in ipairs(characterConnections[player]) do
			connection:Disconnect()
		end
	end

	characterConnections[player] = {}

	table.insert(characterConnections[player], character.ChildAdded:Connect(function(child)
		if child.Name == "Hammer" then
			updatePlayerHighlights()
		end
	end))

	table.insert(characterConnections[player], character.ChildRemoved:Connect(function(child)
		if child.Name == "Hammer" then
			updatePlayerHighlights()
		end
	end))

	updatePlayerHighlights()
end

local function watchPlayer(player)
	if player == LocalPlayer then
		return
	end

	if player.Character then
		watchCharacter(player, player.Character)
	end

	player.CharacterAdded:Connect(function(character)
		task.wait(0.25)
		watchCharacter(player, character)
	end)

	player.CharacterRemoving:Connect(function()
		removePlayerHighlight(player, "Survivor")
		removePlayerHighlight(player, "Beast")
	end)
end

--// COMPUTER HIGHLIGHT LOGIC
--// Only requires ComputerTable to be a Model.

local computerHighlights = {}
local computerColorConnections = {}
local computerRefreshConnection = nil
local computerDescendantAddedConnection = nil
local computerDescendantRemovingConnection = nil

local DEFAULT_COMPUTER_COLOR = Color3.fromRGB(0, 200, 255)

local function isComputerTable(model)
	return model ~= nil and model.Name == "ComputerTable" and model:IsA("Model")
end

local function findDeep(parent, name)
	if not parent then
		return nil
	end

	return parent:FindFirstChild(name, true)
end

local function getScreenPart(computerTable)
	if not computerTable then
		return nil
	end

	local screen = findDeep(computerTable, "Screen")

	if not screen then
		return nil
	end

	if screen:IsA("BasePart") then
		return screen
	end

	if screen:IsA("Model") or screen:IsA("Folder") then
		for _, descendant in ipairs(screen:GetDescendants()) do
			if descendant:IsA("BasePart") then
				return descendant
			end
		end
	end

	return nil
end

local function getComputerColor(computerTable)
	local screenPart = getScreenPart(computerTable)

	if screenPart then
		return screenPart.Color
	end

	return DEFAULT_COMPUTER_COLOR
end

local function disconnectComputerColorConnections(computerTable)
	if computerColorConnections[computerTable] then
		for _, connection in ipairs(computerColorConnections[computerTable]) do
			if connection then
				connection:Disconnect()
			end
		end

		computerColorConnections[computerTable] = nil
	end
end

local function removeComputerHighlight(computerTable)
	local highlight = computerHighlights[computerTable]

	if highlight and highlight.Parent then
		highlight:Destroy()
	end

	computerHighlights[computerTable] = nil
	disconnectComputerColorConnections(computerTable)
end

local function clearComputerHighlights()
	for computerTable, highlight in pairs(computerHighlights) do
		if highlight and highlight.Parent then
			highlight:Destroy()
		end
	end

	for computerTable, connections in pairs(computerColorConnections) do
		for _, connection in ipairs(connections) do
			if connection then
				connection:Disconnect()
			end
		end
	end

	computerHighlights = {}
	computerColorConnections = {}

	if computerRefreshConnection then
		computerRefreshConnection:Disconnect()
		computerRefreshConnection = nil
	end

	if computerDescendantAddedConnection then
		computerDescendantAddedConnection:Disconnect()
		computerDescendantAddedConnection = nil
	end

	if computerDescendantRemovingConnection then
		computerDescendantRemovingConnection:Disconnect()
		computerDescendantRemovingConnection = nil
	end
end

local function hookScreenColor(computerTable, highlight)
	disconnectComputerColorConnections(computerTable)

	computerColorConnections[computerTable] = {}

	local screenPart = getScreenPart(computerTable)

	if not screenPart then
		return
	end

	local colorConnection = screenPart:GetPropertyChangedSignal("Color"):Connect(function()
		if highlight and highlight.Parent then
			highlight.OutlineColor = screenPart.Color
		end
	end)

	local brickColorConnection = screenPart:GetPropertyChangedSignal("BrickColor"):Connect(function()
		if highlight and highlight.Parent then
			highlight.OutlineColor = screenPart.BrickColor.Color
		end
	end)

	table.insert(computerColorConnections[computerTable], colorConnection)
	table.insert(computerColorConnections[computerTable], brickColorConnection)
end

local function createOrUpdateComputerHighlight(computerTable)
	if not highlightComputersEnabled then
		return
	end

	if not isComputerTable(computerTable) then
		removeComputerHighlight(computerTable)
		return
	end

	local color = getComputerColor(computerTable)
	local existing = computerHighlights[computerTable]

	if existing and existing.Parent then
		existing.Adornee = computerTable
		existing.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		existing.FillTransparency = 1
		existing.OutlineTransparency = 0
		existing.OutlineColor = color

		if not computerColorConnections[computerTable] then
			hookScreenColor(computerTable, existing)
		end

		return
	end

	local highlight = Instance.new("Highlight")
	highlight.Name = "ComputerHighlight"
	highlight.Adornee = computerTable
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.OutlineColor = color
	highlight.Parent = highlightFolder

	computerHighlights[computerTable] = highlight
	hookScreenColor(computerTable, highlight)
end

local function updateComputerHighlights()
	if not highlightComputersEnabled then
		return
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if isComputerTable(obj) then
			createOrUpdateComputerHighlight(obj)
		end
	end

	for computerTable, highlight in pairs(computerHighlights) do
		if not computerTable or not computerTable.Parent or not isComputerTable(computerTable) then
			removeComputerHighlight(computerTable)
		else
			local color = getComputerColor(computerTable)

			if highlight and highlight.Parent then
				highlight.Adornee = computerTable
				highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				highlight.FillTransparency = 1
				highlight.OutlineTransparency = 0
				highlight.OutlineColor = color
			else
				removeComputerHighlight(computerTable)
			end
		end
	end
end

local function enableComputerHighlights()
	clearComputerHighlights()

	highlightComputersEnabled = true
	updateComputerHighlights()

	local lastFullRefresh = 0

	computerRefreshConnection = RunService.Heartbeat:Connect(function()
		if not highlightComputersEnabled then
			return
		end

		local now = os.clock()

		if now - lastFullRefresh >= 0.5 then
			lastFullRefresh = now
			updateComputerHighlights()
		end
	end)

	computerDescendantAddedConnection = Workspace.DescendantAdded:Connect(function(descendant)
		if not highlightComputersEnabled then
			return
		end

		if descendant.Name == "ComputerTable" or descendant.Name == "Screen" then
			task.delay(0.2, function()
				if highlightComputersEnabled then
					updateComputerHighlights()
				end
			end)
		end
	end)

	computerDescendantRemovingConnection = Workspace.DescendantRemoving:Connect(function(descendant)
		if not highlightComputersEnabled then
			return
		end

		if descendant.Name == "ComputerTable" then
			removeComputerHighlight(descendant)
			return
		end

		if descendant.Name == "Screen" then
			task.defer(function()
				if highlightComputersEnabled then
					updateComputerHighlights()
				end
			end)
		end
	end)
end

local function disableComputerHighlights()
	highlightComputersEnabled = false
	clearComputerHighlights()
end

--// UI TOGGLES

Visuals:CreateToggle({
	Name = "Highlight Survivors",
	Default = false,
	Callback = function(enabled)
		highlightSurvivorsEnabled = enabled

		if enabled then
			updatePlayerHighlights()
		else
			clearSurvivorHighlights()
		end
	end
})

Visuals:CreateToggle({
	Name = "Highlight Beast",
	Default = false,
	Callback = function(enabled)
		highlightBeastEnabled = enabled

		if enabled then
			updatePlayerHighlights()
		else
			clearBeastHighlights()
		end
	end
})

Visuals:CreateToggle({
	Name = "Highlight Computers",
	Default = false,
	Callback = function(enabled)
		if enabled then
			enableComputerHighlights()
		else
			disableComputerHighlights()
		end
	end
})

--// PLAYER WATCHERS

for _, player in ipairs(Players:GetPlayers()) do
	watchPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
	watchPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
	removePlayerHighlight(player, "Survivor")
	removePlayerHighlight(player, "Beast")

	if characterConnections[player] then
		for _, connection in ipairs(characterConnections[player]) do
			connection:Disconnect()
		end

		characterConnections[player] = nil
	end
end)

--// REFRESH LOOP FOR PLAYER HIGHLIGHTS

RunService.RenderStepped:Connect(function()
	if highlightSurvivorsEnabled or highlightBeastEnabled then
		updatePlayerHighlights()
	end
end)
