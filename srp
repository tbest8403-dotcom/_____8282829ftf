local BASE_URL = "https://raw.githubusercontent.com/tbest8403-dotcom/_____8282829ftf/main/"

local function loadModule(fileName)
	local url = BASE_URL .. fileName
	local source = game:HttpGet(url)

	local loadedFunction, loadError = loadstring(source)
	if not loadedFunction then
		error("Failed to load " .. fileName .. ": " .. tostring(loadError))
	end

	return loadedFunction()
end

local modules = {
	PlayerHighlights = loadModule("playerhightlights"),
	ComputerHighlight = loadModule("ComputerHighlight"),
	InfiniteWallHop = loadModule("Infinitewallhop"),
	GhostMode = loadModule("ghost")
}

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local NightUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/asutse0/NightUILibrary/refs/heads/main/Project"))()

local Window = NightUI:CreateWindow({
	Title = "Flee the Facility",
	KeySystem = true,
	Key = "Flee22",
	DiscordLink = "https://discord.gg/Jc5dpWqBtZ"
})

local Visuals = Window:CreateTab("Visuals")
local Movement = Window:CreateTab("Movement")

local highlightFolder = PlayerGui:FindFirstChild("DebugHighlights")
if not highlightFolder then
	highlightFolder = Instance.new("Folder")
	highlightFolder.Name = "DebugHighlights"
	highlightFolder.Parent = PlayerGui
end

local playerHighlights = modules.PlayerHighlights.new(highlightFolder)
local computerHighlights = modules.ComputerHighlight.new(highlightFolder)
local infiniteWallHop = modules.InfiniteWallHop.new()
local ghostMode = modules.GhostMode.new()

Visuals:CreateToggle({
	Name = "Highlight Survivors",
	Default = false,
	Callback = function(enabled)
		playerHighlights:SetSurvivorsEnabled(enabled)
	end
})

Visuals:CreateToggle({
	Name = "Highlight Beast",
	Default = false,
	Callback = function(enabled)
		playerHighlights:SetBeastEnabled(enabled)
	end
})

Visuals:CreateToggle({
	Name = "Highlight Computers",
	Default = false,
	Callback = function(enabled)
		if enabled then
			computerHighlights:Enable()
		else
			computerHighlights:Disable()
		end
	end
})

Movement:CreateToggle({
	Name = "Infinite Wall Hop",
	Default = false,
	Callback = function(enabled)
		if enabled then
			infiniteWallHop:Enable()
		else
			infiniteWallHop:Disable()
		end
	end
})

Movement:CreateToggle({
	Name = "Ghost Mode",
	Default = false,
	Callback = function(enabled)
		if enabled then
			ghostMode:Enable()
		else
			ghostMode:Disable()
		end
	end
})

playerHighlights:Start()

LocalPlayer.CharacterAdded:Connect(function()
	infiniteWallHop:Reset()

	if ghostMode:IsEnabled() then
		ghostMode:Disable()
	end
end)

RunService.RenderStepped:Connect(function()
	playerHighlights:Refresh()
end)
